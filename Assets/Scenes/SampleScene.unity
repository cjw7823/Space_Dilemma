      m_Calls: []
  m_text: "\uC57D 34\uC5B5 \uB144 \uB41C \uD654\uC0B0\uC554\uC785\uB2C8\uB2E4. \uC6A9\uC554\uC774
    \uC2DD\uC744 \uB54C \uC0DD\uAE34 \uAE30\uCCB4 \uBC29\uC6B8\uC774 \uB465\uADFC
    \uAD6C\uBA4D\uC73C\uB85C \uB0A8\uC558\uC73C\uBA70, \uAD6C\uBA4D\uC740 \uB3CC
    \uBD80\uD53C\uC758 \uC57D \uC808\uBC18\uC744 \uCC28\uC9C0\uD569\uB2C8\uB2E4.\n\n\uB370\uC774\uBE44\uB4DC
    \uC2A4\uCF67\uC774 \uB85C\uBC84\uB97C \uC7A0\uC2DC \uC138\uC6B4 \uC0AC\uC774
    \uC8FC\uC6CC \u2018\uC548\uC804\uBCA8\uD2B8 \uBC14\uC704\u2019\uB77C\uB294 \uBCC4\uBA85\uC774
    \uBD99\uC5C8\uC2B5\uB2C8\uB2E4. \uC774 \uAD6C\uBA4D\uB4E4\uC740 \uB2EC\uC758
    \uC6A9\uC554\uC774 \uC5B4\uB5BB\uAC8C \uD758\uB800\uB294\uC9C0 \uC54C\uB824 \uC90D\uB2C8\uB2E4."
