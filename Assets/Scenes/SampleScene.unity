--- !u!114 &233601585
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 233601584}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC9C0\uAD6C\uC5D0\uC11C\uB294 \uBFCC\uB9AC\uAC00 \uB300\uCCB4\uB85C \uC911\uB825
    \uBC29\uD5A5\uC73C\uB85C \uC790\uB78D\uB2C8\uB2E4. \uADF8\uB807\uB2E4\uBA74 \uC911\uB825\uC774
    \uC9C0\uAD6C\uC758 \uC57D 1/6\uC778 \uB2EC\uC5D0\uC11C\uB294 \uBFCC\uB9AC\uAC00
    \uC5B4\uB5A4 \uBC29\uD5A5\uC73C\uB85C \uC790\uB784\uAE4C\uC694?\n\n\uC774 \uAC00\uC0C1
    \uC5F0\uAD6C\uC758 \uBAA9\uD45C\uB294 \uB2EC\uC758 \uC57D\uD55C \uC911\uB825\uC774
    \uBFCC\uB9AC\uC758 \uC131\uC7A5\uACFC \uBC29\uD5A5\uC5D0 \uC5B4\uB5A4 \uC601\uD5A5\uC744
    \uC8FC\uB294\uC9C0 \uC54C\uC544\uBCF4\uB294 \uAC83\uC785\uB2C8\uB2E4.\n\n\uAC19\uC740
    \uC885\uB958\uC758 \uC2DD\uBB3C\uC5D0 \uBE5B\xB7\uBB3C\xB7\uC628\uB3C4 \uC870\uAC74\uC744
    \uB9DE\uCD94\uACE0, \uC9C0\uAD6C \uC911\uB825\uC758 \uB300\uC870\uAD70\uACFC
    \uB2EC \uC911\uB825\uC758 \uC2E4\uD5D8\uAD70\uC744 \uBE44\uAD50\uD558\uB294 \uC5F0\uAD6C\uB97C
    \uACC4\uD68D\uD569\uB2C8\uB2E4. \uBFCC\uB9AC \uB05D\uC758 \uBC29\uD5A5, \uD718\uC5B4\uC9C4
    \uC815\uB3C4, \uAE38\uC774\uB97C \uC2DC\uAC04\uC5D0 \uB530\uB77C \uAE30\uB85D\uD569\uB2C8\uB2E4.\n\n\uAD00\uCC30
    \uC2DC\uAC04\uC740 28\uC2DC\uAC04 40\uBD84\uC785\uB2C8\uB2E4. \uC774 \uC2DC\uAC04\uC740
    \uC218\uD655\uC774\uB098 \uC2DD\uB7C9 \uC0DD\uC0B0\uC5D0 \uAC78\uB9AC\uB294 \uC2DC\uAC04\uC774
    \uC544\uB2D9\uB2C8\uB2E4. \uC57D\uD55C \uC911\uB825\uC5D0\uC11C\uB3C4 \uBFCC\uB9AC\uAC00
    \uBB3C\uACFC \uC601\uC591\uBD84\uC5D0 \uC798 \uB2FF\uB3C4\uB85D, \uBBF8\uB798
    \uB2EC \uAE30\uC9C0\uC758 \uC7AC\uBC30 \uC7A5\uCE58\uB97C \uC124\uACC4\uD558\uB294
    \uB370 \uB3C4\uC6C0\uC774 \uB420 \uC5F0\uAD6C\uC785\uB2C8\uB2E4."
