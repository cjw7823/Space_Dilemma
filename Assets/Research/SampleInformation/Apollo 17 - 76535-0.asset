  m_Name: Apollo 17 - 76535-0
  m_EditorClassIdentifier: Assembly-CSharp::SpaceDilemma.Research.LunarSampleInformation
  sampleId: 76535-0
  apolloMission: 17
  classificationEnglish: Troctolite
  classificationKorean: "\uD2B8\uB85D\uD1A8\uB77C\uC774\uD2B8 (\uAC10\uB78C\uC11D\xB7\uC0AC\uC7A5\uC11D\uC744
    \uD488\uC740 \uC554\uC11D)"
  locationEnglish: "North Massif, Station 6, Taurus\u2013Littrow Valley"
  locationKorean: "\uD0C0\uC6B0\uB8E8\uC2A4\u2013\uB9AC\uD2B8\uB85C \uACC4\uACE1
    \uBD81\uCABD \uC0B0\uC9C0, \uAD00\uCE21 \uC9C0\uC810 6"
  descriptionEnglish: "This rock has large grains of two minerals: olivine and plagioclase. Its big crystals show that it cooled slowly deep in the lunar crust.\n\nNASA estimates it crystallized about 4.3 billion years ago. Its magnetic record helps scientists investigate the young Moon's magnetic field."
  descriptionKorean: "\uAC10\uB78C\uC11D\uACFC \uC0AC\uC7A5\uC11D\uC774\uB77C\uB294
    \uB450 \uAD11\uBB3C\uC758 \uD070 \uC54C\uAC31\uC774\uAC00 \uAC70\uC758 \uBE44\uC2B7\uD55C
    \uC591\uC73C\uB85C \uB4E4\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uD070 \uACB0\uC815\uC740
    \uB2EC \uC9C0\uAC01 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC2DD\uC5C8\uB2E4\uB294
    \uB2E8\uC11C\uC785\uB2C8\uB2E4.\n\nNASA\uB294 \uC57D 43\uC5B5 \uB144 \uC804 \uACB0\uC815\uC774
    \uC0DD\uACBC\uB2E4\uACE0 \uCD94\uC815\uD569\uB2C8\uB2E4. \uC774 \uB3CC\uC5D0
    \uB0A8\uC740 \uC790\uAE30 \uAE30\uB85D\uC740 \uC5B4\uB9B0 \uB2EC\uC5D0 \uC790\uAE30\uC7A5\uC774
    \uC788\uC5C8\uB294\uC9C0 \uC5F0\uAD6C\uD558\uB294 \uB370 \uB3C4\uC6C0\uC744 \uC90D\uB2C8\uB2E4."
  sourceUrl: https://ares.jsc.nasa.gov/astromaterials3d/sample-details.htm?sample=76535-0
